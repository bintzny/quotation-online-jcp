// Quotation Online JCP — database schema
// Auth tables (user / session / account / verification / twoFactor) follow Better Auth's
// expected shape (core + admin plugin + two-factor plugin). App fields are added on User.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // admin plugin — role holds comma-separated roles, e.g. "sales,executive"
  role             String?   @default("sales")
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime? @db.Timestamptz(3)
  // two-factor plugin
  twoFactorEnabled Boolean?  @default(false)

  // app fields
  phone              String?
  employeeCode       String?   @unique // salesperson code, used to match Express data
  companyId          String?
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)

  company          Company?                 @relation(fields: [companyId], references: [id])
  extraCompanies   UserCompany[]
  ownedCustomers   Customer[]               @relation("CustomerOwner")
  ownerCandidacies CustomerOwnerCandidate[]
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  auditLogs        AuditLog[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ───────────────────────────── Companies ─────────────────────────────

/// One of the 3 issuing companies (separate legal entities, own letterhead and numbering).
model Company {
  id                  String   @id @default(cuid())
  code                String   @unique // document prefix, e.g. BKK → QT-BKK-2611-0001
  nameTh              String
  nameEn              String?
  taxId               String
  branchCode          String   @default("00000") // 00000 = head office
  addressTh           String
  addressEn           String?
  phone               String?
  email               String?
  website             String?
  logoKey             String? // object-storage key (M3)
  vatRegistered       Boolean  @default(true)
  vatRateBp           Int      @default(700) // basis points: 700 = 7.00%
  defaultValidityDays Int      @default(30)
  quoteTermsTh        String?
  quoteTermsEn        String?
  senderEmail         String? // From address for emails sent by the system
  senderName          String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  users                User[]
  userCompanies        UserCompany[]
  customerExpressCodes CustomerExpressCode[]

  @@map("company")
}

/// Extra companies a user may issue quotations for (besides their main company).
model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company")
}

// ───────────────────────────── Customers ─────────────────────────────

enum CustomerType {
  JURISTIC // นิติบุคคล — tax ID required
  INDIVIDUAL // บุคคลธรรมดา
}

enum CustomerStatus {
  ACTIVE
  PENDING_OWNER // import found different salespeople; nobody may quote until resolved
  LOST // marked lost by the owner (M6)
}

/// One shared customer list for all 3 companies. Each customer has at most one owner.
model Customer {
  id               String         @id @default(cuid())
  type             CustomerType
  name             String
  taxId            String? // 13 digits; required for JURISTIC
  branchCode       String         @default("00000") // 00000 = head office
  branchName       String?
  address          String
  phone            String?
  email            String?
  creditDays       Int            @default(0)
  note             String?
  status           CustomerStatus @default(ACTIVE)
  ownerId          String?
  owner            User?          @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastPurchaseDate DateTime?      @db.Date // M6
  createdById      String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  contacts        CustomerContact[]
  ownerHistory    CustomerOwnerHistory[]
  ownerCandidates CustomerOwnerCandidate[]
  expressCodes    CustomerExpressCode[]

  // Blocks duplicate juristic customers (NULL tax IDs never collide).
  @@unique([taxId, branchCode])
  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@map("customer")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId])
  @@map("customer_contact")
}

enum OwnerChangeReason {
  CREATED // salesperson created the customer
  IMPORT // set from Express salesperson code
  QUOTE_CLAIM // first quotation for an unowned customer (M2)
  TRANSFER // executive/admin changed the owner
  PENDING_RESOLVED // executive/admin chose among import candidates
}

/// Every owner change; the change date is used to split sales figures between people.
model CustomerOwnerHistory {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromUserId  String?
  toUserId    String?
  reason      OwnerChangeReason
  note        String?
  changedById String?
  changedAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@index([customerId, changedAt])
  @@map("customer_owner_history")
}

/// Salespeople suggested as owner by different Express files, for PENDING_OWNER customers.
model CustomerOwnerCandidate {
  customerId String
  userId     String
  companyId  String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([customerId, userId])
  @@map("customer_owner_candidate")
}

/// Customer code in each company's Express database (used to match later imports).
model CustomerExpressCode {
  companyId  String
  code       String
  customerId String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([companyId, code])
  @@index([customerId])
  @@map("customer_express_code")
}

// ───────────────────────────── Products ─────────────────────────────

/// Prices are integer satang (8000 = 80.00 baht), excluding VAT.
model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameEn          String?
  category        String?
  unit            String
  listPriceSatang Int
  minPriceSatang  Int? // never sent to sales users; null only for service items
  isService       Boolean  @default(false) // e.g. shipping: never needs approval
  active          Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@map("product")
}

// ───────────────────────────── Imports ─────────────────────────────

enum ImportKind {
  CUSTOMERS
  PRODUCTS
}

model ImportBatch {
  id            String     @id @default(cuid())
  kind          ImportKind
  companyId     String? // customers: which company's Express file
  fileName      String
  rowCount      Int
  createdCount  Int
  updatedCount  Int
  conflictCount Int        @default(0)
  skippedCount  Int        @default(0)
  createdById   String
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("import_batch")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. user.create, company.update
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
