// Quotation Online JCP — database schema
// Auth tables (user / session / account / verification / twoFactor) follow Better Auth's
// expected shape (core + admin plugin + two-factor plugin). App fields are added on User.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // admin plugin — role holds comma-separated roles, e.g. "sales,executive"
  role             String?   @default("sales")
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime? @db.Timestamptz(3)
  // two-factor plugin
  twoFactorEnabled Boolean?  @default(false)

  // app fields
  phone              String?
  employeeCode       String?   @unique // salesperson code, used to match Express data
  companyId          String?
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  signatureKey       String? // storage key of the signature image printed on quotations

  company          Company?                  @relation(fields: [companyId], references: [id])
  extraCompanies   UserCompany[]
  ownedCustomers   Customer[]                @relation("CustomerOwner")
  ownerCandidacies CustomerOwnerCandidate[]
  ownedQuotations  Quotation[]               @relation("QuotationOwner")
  notifications    Notification[]
  followups        Followup[]
  transferRequests CustomerTransferRequest[] @relation("TransferRequester")
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  auditLogs        AuditLog[]
  salesTargets     SalesTarget[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ───────────────────────────── Companies ─────────────────────────────

/// One of the 3 issuing companies (separate legal entities, own letterhead and numbering).
model Company {
  id                  String   @id @default(cuid())
  code                String   @unique // document prefix, e.g. BKK → QT-BKK-2611-0001
  nameTh              String
  nameEn              String?
  taxId               String
  branchCode          String   @default("00000") // 00000 = head office
  addressTh           String
  addressEn           String?
  phone               String?
  email               String?
  website             String?
  logoKey             String? // object-storage key (M3)
  vatRegistered       Boolean  @default(true)
  vatRateBp           Int      @default(700) // basis points: 700 = 7.00%
  defaultValidityDays Int      @default(30)
  quoteTermsTh        String?
  quoteTermsEn        String?
  senderEmail         String? // From address for emails sent by the system
  senderName          String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  users                User[]
  userCompanies        UserCompany[]
  customerExpressCodes CustomerExpressCode[]
  customerExpressSales CustomerExpressSale[]
  quotations           Quotation[]
  docSequences         DocSequence[]

  @@map("company")
}

/// Extra companies a user may issue quotations for (besides their main company).
model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company")
}

// ───────────────────────────── Customers ─────────────────────────────

enum CustomerType {
  JURISTIC // นิติบุคคล — tax ID required
  INDIVIDUAL // บุคคลธรรมดา
}

enum CustomerStatus {
  ACTIVE
  PENDING_OWNER // import found different salespeople; nobody may quote until resolved
  LOST // marked lost by the owner (M6)
}

enum CustomerLostReason {
  CLOSED_BUSINESS // เลิกกิจการ
  COMPETITOR // ย้ายไปใช้คู่แข่ง
  OTHER
}

/// Result chosen when the owner records a contact with an inactive customer.
enum DormantOutcome {
  STILL_CUSTOMER // no reminder for 30 days
  CLOSED_BUSINESS
  COMPETITOR
  OTHER
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED // withdrawn by the requester, or the customer was transferred another way
}

/// A salesperson asks to take over another salesperson's inactive customer; an executive decides.
model CustomerTransferRequest {
  id           String                @id @default(cuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requesterId  String
  requester    User                  @relation("TransferRequester", fields: [requesterId], references: [id])
  fromOwnerId  String? // owner when the request was made
  reason       String
  status       TransferRequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?             @db.Timestamptz(3)
  decisionNote String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  // one open request per salesperson and customer: partial unique index in the migration
  @@index([status, createdAt])
  @@index([customerId, status])
  @@map("customer_transfer_request")
}

/// Small admin-adjustable values (key → JSON value).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("setting")
}

/// Periodic emails already sent (each person gets one per period).
model MailDigest {
  userId      String
  kind        String // "dormant-weekly"
  periodStart DateTime @db.Date
  sentAt      DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, kind, periodStart])
  @@map("mail_digest")
}

/// One shared customer list for all 3 companies. Each customer has at most one owner.
model Customer {
  id               String         @id @default(cuid())
  type             CustomerType
  name             String
  taxId            String? // 13 digits; required for JURISTIC
  branchCode       String         @default("00000") // 00000 = head office
  branchName       String?
  address          String
  phone            String?
  email            String?
  creditDays       Int            @default(0)
  note             String?
  status           CustomerStatus @default(ACTIVE)
  ownerId          String?
  owner            User?          @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastPurchaseDate DateTime?      @db.Date // the later of the last Won here and the last Express sale
  nextFollowupOn   DateTime?      @db.Date // next customer-level follow-up (from the latest one)
  createdById      String?

  // M6: inactive customers ("ลูกค้าที่หายไป")
  expressLastSaleDate   DateTime?           @db.Date // from the monthly Express file
  expressSales12mSatang BigInt? // optional "sales in the last 12 months" from that file
  dormantSnoozedUntil   DateTime?           @db.Date // owner said "still a customer": no reminder until after this day
  dormantNotifiedAt     DateTime?           @db.Timestamptz(3) // bell once per inactive period
  lostReason            CustomerLostReason?
  lostNote              String?
  lostAt                DateTime?           @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  contacts         CustomerContact[]
  ownerHistory     CustomerOwnerHistory[]
  ownerCandidates  CustomerOwnerCandidate[]
  expressCodes     CustomerExpressCode[]
  expressSales     CustomerExpressSale[]
  quotations       Quotation[]
  followups        Followup[]
  transferRequests CustomerTransferRequest[]

  // Blocks duplicate juristic customers (NULL tax IDs never collide).
  @@unique([taxId, branchCode])
  @@index([ownerId])
  @@index([status])
  @@index([name])
  @@index([ownerId, nextFollowupOn])
  @@index([lastPurchaseDate])
  @@map("customer")
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId])
  @@map("customer_contact")
}

enum OwnerChangeReason {
  CREATED // salesperson created the customer
  IMPORT // set from Express salesperson code
  QUOTE_CLAIM // first quotation for an unowned customer (M2)
  TRANSFER // executive/admin changed the owner
  PENDING_RESOLVED // executive/admin chose among import candidates
}

/// Every owner change; the change date is used to split sales figures between people.
model CustomerOwnerHistory {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromUserId  String?
  toUserId    String?
  reason      OwnerChangeReason
  note        String?
  changedById String?
  changedAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@index([customerId, changedAt])
  @@map("customer_owner_history")
}

/// Salespeople suggested as owner by different Express files, for PENDING_OWNER customers.
model CustomerOwnerCandidate {
  customerId String
  userId     String
  companyId  String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([customerId, userId])
  @@map("customer_owner_candidate")
}

/// Customer code in each company's Express database (used to match later imports).
model CustomerExpressCode {
  companyId  String
  code       String
  customerId String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([companyId, code])
  @@index([customerId])
  @@map("customer_express_code")
}

/// Last sale date (and optional 12-month sales) per customer and company, from the monthly Express
/// file of that company. customer.expressLastSaleDate / expressSales12mSatang hold the latest date and
/// the sum over companies (M6).
model CustomerExpressSale {
  customerId     String
  companyId      String
  lastSaleDate   DateTime @db.Date
  sales12mSatang BigInt?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([customerId, companyId])
  @@map("customer_express_sale")
}

// ───────────────────────────── Products ─────────────────────────────

/// Prices are integer satang (8000 = 80.00 baht), excluding VAT.
model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameEn          String?
  category        String?
  unit            String
  listPriceSatang Int
  minPriceSatang  Int? // never sent to sales users; null only for service items
  isService       Boolean  @default(false) // e.g. shipping: never needs approval
  active          Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  quotationItems QuotationItem[]

  @@index([category])
  @@map("product")
}

// ───────────────────────────── Quotations ─────────────────────────────

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL // M4
  APPROVED // M4
  REJECTED // M4
  SENT
  WON // M5
  LOST // M5
  EXPIRED // M5
  CANCELLED
}

enum DiscountType {
  NONE
  PERCENT // value in basis points (1000 = 10%)
  AMOUNT // value in satang
}

/// Running number per company per month (Bangkok time). Incremented with an atomic upsert.
model DocSequence {
  companyId  String
  yearMonth  String // "2611"
  lastNumber Int
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, yearMonth])
  @@map("doc_sequence")
}

/// Header of a quotation. Money is satang (BigInt for sums), quantities are thousandths.
/// Customer and company details are copied in when saved, so later edits to the customer do not
/// change a document already given out.
model Quotation {
  id          String          @id @default(cuid())
  number      String          @unique // QT-BKK-2611-0001 (revision suffix is added for display)
  revision    Int             @default(0)
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  ownerId     String
  owner       User            @relation("QuotationOwner", fields: [ownerId], references: [id])
  ownerSince  DateTime?       @db.Timestamptz(3) // set when the customer was transferred while this was open (M6)
  createdById String // the original creator ("ผู้สร้างเดิม"); stays when the quotation moves
  status      QuotationStatus @default(DRAFT)

  issueDate    DateTime @db.Date
  validityDays Int
  validUntil   DateTime @db.Date
  creditDays   Int

  // customer snapshot
  customerName       String
  customerTaxId      String?
  customerBranchCode String
  customerBranchName String?
  customerAddress    String
  contactId          String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?

  billDiscountType    DiscountType @default(NONE)
  billDiscountValue   BigInt       @default(0) // basis points or satang
  subtotalSatang      BigInt
  billDiscountSatang  BigInt
  afterDiscountSatang BigInt
  vatRateBp           Int
  vatSatang           BigInt
  totalSatang         BigInt
  requiresApproval    Boolean

  note          String?
  terms         String?
  cancelReason  String?
  sentAt        DateTime?   @db.Timestamptz(3)
  firstSentAt   DateTime?   @db.Timestamptz(3) // first time any revision was sent (M7: proposed value month)
  firstSentById String? // owner who first sent it (proposed value is credited to them)
  cancelledAt   DateTime?   @db.Timestamptz(3)
  copiedFromId  String?
  pdfLanguage   DocLanguage @default(TH) // language of the PDF given to the customer

  // M5: follow-up and closing
  nextFollowupOn  DateTime?   @db.Date // from the latest quotation follow-up; null = nothing scheduled
  lastFollowupAt  DateTime?   @db.Timestamptz(3)
  staleNotifiedAt DateTime?   @db.Timestamptz(3) // "no follow-up for 7 days" bell, once per quiet period
  expiredAt       DateTime?   @db.Timestamptz(3)
  closedAt        DateTime?   @db.Timestamptz(3) // Won or Lost (final: cannot be undone)
  poNumber        String?
  poDate          DateTime?   @db.Date
  poKey           String? // optional PO file (PDF/PNG/JPEG) in private storage
  lostReason      LostReason?
  lostNote        String?
  version         Int         @default(1) // optimistic lock for edits from two tabs
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  items     QuotationItem[]
  revisions QuotationRevision[]
  emails    QuotationEmail[]
  approvals ApprovalRequest[]
  followups Followup[]

  @@index([ownerId, status])
  @@index([ownerId, nextFollowupOn])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([status, validUntil])
  @@index([firstSentAt])
  @@index([closedAt])
  @@map("quotation")
}

model QuotationItem {
  id              String       @id @default(cuid())
  quotationId     String
  quotation       Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position        Int
  productId       String? // null = free-typed line (always needs approval)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode     String?
  name            String
  nameEn          String? // product's English name when saved (English PDF)
  unit            String
  isService       Boolean      @default(false)
  quantityMilli   Int // 1.5 units = 1500
  unitPriceSatang Int
  listPriceSatang Int? // product price when saved
  minPriceSatang  Int? // product minimum when saved — never sent to sales users
  discountType    DiscountType @default(NONE)
  discountValue   BigInt       @default(0) // basis points or satang
  discountSatang  BigInt
  netSatang       BigInt // line amount after the line discount
  billShareSatang BigInt // part of the bill discount allocated to this line
  approvalReason  String? // belowMin | customLine | noMinPrice

  @@unique([quotationId, position])
  @@map("quotation_item")
}

enum DocLanguage {
  TH
  EN
}

/// What was given to the customer for each revision: the data and the exact PDF.
model QuotationRevision {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int
  snapshot    Json // quotation + the document data (company, seller) as printed; no minimum prices
  pdfKey      String? // storage key of the PDF that was sent
  sentAt      DateTime  @db.Timestamptz(3)
  sentById    String

  @@unique([quotationId, revision])
  @@map("quotation_revision")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  COUNTERED // the executive set other prices and approved them
  WITHDRAWN // the salesperson took the request back (or cancelled the quotation)
}

/// A request to approve prices below the minimum (or free-typed lines). At most one is pending
/// per quotation (partial unique index in the migration).
model ApprovalRequest {
  id            String         @id @default(cuid())
  quotationId   String
  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision      Int
  requestedById String
  reason        String
  status        ApprovalStatus @default(PENDING)
  lines         Json // flagged lines when requested (prices, minimums, reasons) — shown to executives only
  totalSatang   BigInt // quotation total when requested
  approvedLines Json? // prices the decision allows: later edits at or above these stay approved
  counterLines  Json? // what the executive changed: [{ position, name, fromSatang, toSatang }]
  decidedById   String?
  decidedAt     DateTime?      @db.Timestamptz(3)
  decisionNote  String?
  remindedAt    DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([quotationId, createdAt])
  @@index([status, createdAt])
  @@map("approval_request")
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_COUNTERED
  APPROVAL_WITHDRAWN
  APPROVAL_REMINDER
  QUOTATION_EXPIRED // M5
  FOLLOWUP_STALE // M5: sent quotation without a follow-up for 7 days
  CUSTOMER_DORMANT // M6: an owned customer has not bought for the set period
  CUSTOMER_TRANSFERRED_IN // M6: you are the new owner
  CUSTOMER_TRANSFERRED_OUT // M6: a customer of yours was given to someone else
  TRANSFER_REQUESTED // M6: to executives
  TRANSFER_APPROVED // M6: to the requester
  TRANSFER_REJECTED // M6: to the requester
  QUOTATIONS_TRANSFERRED_IN // M6: open quotations handed over when an account's work is transferred
}

/// The bell in the header.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  quotationId String?
  customerId  String? // customer notifications (M6)
  data        Json // { number, customer, actor } for the message
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Emails sent from the system with the quotation PDF attached.
model QuotationEmail {
  id                String    @id @default(cuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision          Int
  to                String[]
  cc                String[]
  subject           String
  fromAddress       String
  providerMessageId String? // id from the email service (null for the development outbox)
  sentById          String
  sentAt            DateTime  @default(now()) @db.Timestamptz(3)

  @@index([quotationId])
  @@index([sentById, sentAt])
  @@map("quotation_email")
}

// ───────────────────────────── Imports ─────────────────────────────

enum ImportKind {
  CUSTOMERS
  PRODUCTS
  LAST_SALES // monthly "last sale date per customer" from Express (M6)
}

model ImportBatch {
  id            String     @id @default(cuid())
  kind          ImportKind
  companyId     String? // customers: which company's Express file
  fileName      String
  rowCount      Int
  createdCount  Int
  updatedCount  Int
  conflictCount Int        @default(0)
  skippedCount  Int        @default(0)
  createdById   String
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("import_batch")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. user.create, company.update
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

enum LostReason {
  PRICE
  COMPETITOR
  NO_BUDGET
  OTHER
}

enum FollowupChannel {
  PHONE
  LINE
  VISIT
  EMAIL
  OTHER
}

/// A contact with the customer: about one quotation, or about the customer in general
/// (quotationId null). Kept as a log: never edited or deleted.
model Followup {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationId String?
  quotation   Quotation?      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  contactedOn DateTime        @db.Date
  channel     FollowupChannel
  detail      String
  nextDate    DateTime?       @db.Date
  outcome     DormantOutcome? // customer-level contact with an inactive customer (M6)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([quotationId, createdAt])
  @@index([customerId, createdAt])
  @@map("followup")
}

/// Monthly Won target (before VAT) of one salesperson, all companies together (M7).
model SalesTarget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        DateTime @db.Date // first day of the month
  amountSatang BigInt
  updatedById  String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, month])
  @@index([month])
  @@map("sales_target")
}
