# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quotation_dev?schema=public"

# Better Auth: generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public URL of the app (used in emails / reset links)
APP_URL="http://localhost:3000"

# Optional: email of the first administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL=""

# Private files (logos, signatures, sent PDFs). Development default: ./storage (git-ignored).
# Production: a persistent disk path (or object storage, added in M8).
STORAGE_DIR=""

# Email. Without RESEND_API_KEY, development writes mail to storage/outbox/; production refuses.
RESEND_API_KEY=""
# Sender for system mail (password reset), e.g. "Quotation JCP <no-reply@example.com>"
MAIL_FROM=""

# Chrome/Chromium used to print PDFs. Auto-detected on Windows and in the Docker image.
CHROME_PATH=""

# Secret the scheduler (Render Cron) sends to /api/cron/* as "Authorization: Bearer <secret>".
# At least 32 characters; without it the cron endpoints do not exist.
CRON_SECRET=""

# Which request header holds the real client IP behind the hosting proxy (rate limits, audit log).
# Leave empty until checked on the live host with /api/ops/ip-check (docs/deploy.md); then e.g. "true-client-ip".
CLIENT_IP_HEADER=""
# Without CLIENT_IP_HEADER: how many proxies append to X-Forwarded-For (the address they added is used). Default 1.
TRUSTED_PROXY_HOPS=""
